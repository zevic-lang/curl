module Main

import Zevic.Console
import Zevic.Env
import Zevic.Http
import Zevic.Text
import Curl

// fetch ADDRESS: prints the status, the headers and the first lines of the body of an http:// or https:// address.
//
//     zevpm run -- https://example.com/
//
// CURL_CA_BUNDLE, when it is set, is a file of certificates to trust instead of the ones of the system.
// HTTPS_PROXY and NO_PROXY are used as usual.

fn Run(url: String) -> Result<Unit, Error> {
    mut c: Curl.Client = Curl.Client.Open()?
    defer c.Close()
    c.TimeoutMs = 15000
    match (Env.Get("CURL_CA_BUNDLE")) {
        Some(path) => { c.CaFile = path },
        None => {},
    }

    let r: Curl.Reply = c.Fetch(Http.Request.New("GET", url))?
    Console.Println("${r.Status} ${r.Url}")
    for (f in r.Headers) {
        Console.Println("${f.Name}: ${f.Value}")
    }
    Console.Println("")
    mut shown: I64 = 0
    for (line in Text.Lines(r.AsText())) {
        if (shown < 6) {
            Console.Println(line)
        }
        shown += 1
    }
    Console.Println("(${r.Body.Len()} bytes, ${shown} lines)")
    Ok(())
}

fn Main() {
    let args: Array<String> = Env.RawArgs()
    if (args.Len() != 1) {
        Console.Eprintln("usage: fetch ADDRESS")
        Env.Exit(2)
    }
    match (Run(args[0])) {
        Ok(_) => {},
        Err(e) => {
            Console.Eprintln("error (${e.Kind().ToString()}): ${e.Message()}")
            Env.Exit(1)
        },
    }
}
